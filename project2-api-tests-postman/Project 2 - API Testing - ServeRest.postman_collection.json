      "name": "02 - Users",
      "item": [
        {
          "name": "Create User (Duplicated email)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "                                                "
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "\r\npm.test(\"Status code is 400\", function () {\r\n    pm.response.to.have.status(400);\r\n});\r\n\r\npm.test(\"API rejects duplicate email\", function () {\r\n    const jsonData = pm.response.json();\r\n\r\n    pm.expect(jsonData.message).to.be.a(\"string\");\r\n    pm.expect(jsonData.message.toLowerCase()).to.include(\"email\");\r\n});\r\n"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"nome\": \"Izabel QA duplicate\",\r\n  \"email\": \"{{email}}\",\r\n  \"password\": \"123456\",\r\n  \"administrador\": \"true\"\r\n}\r\n",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "https://serverest.dev/usuarios",
              "protocol": "https",
              "host": [
                "serverest",
                "dev"
              ],
              "path": [
                "usuarios"
              ]
            }
          },
          "response": []
        },
        {
          "name": "List Users",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "//Valida o corpo da resposta.\r",
                  "pm.test(\"Response body is not empty\", function() {\r",
                  "    pm.expect(pm.response.json()).to.not.be.empty;\r",
                  "});\r",
                  "//Verifica se o primeiro usuário tem _id.\r",
                  "pm.test(\"First user has _id\", function () {\r",
                  "    pm.expect(pm.response.json().usuarios[0]).to.have.property(\"_id\");\r",
                  "});\r",
                  "//Testa se o array existe\r",
                  "pm.test(\"Response has usuarios array\", function () {\r",
                  "    pm.expect(pm.response.json()).to.have.property(\"usuarios\");\r",
                  "});\r",
                  "//Testar se ha pelo menos um usuário\r",
                  "pm.test(\"At least one user is returned\", function () {\r",
                  "    pm.expect(pm.response.json().usuarios.length).to.be.above(0);\r",
                  "});\r",
                  "//salvando o id do primeiro usuario numa variável.\r",
                  "if (pm.response.code === 200) {\r",
                  "    let response = pm.response.json();\r",
                  "    let userId = response.usuarios[0]._id;\r",
                  "\r",
                  "    pm.environment.set(\"userId\", userId);\r",
                  "}\r",
                  "\r",
                  "\r",
                  "\r",
                  "\r",
                  "\r",
                  "\r",
                  "\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
