        {
          "name": "Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const responseData = pm.response.json();\r\n\r\npm.environment.set(\"userId\", responseData._id);\r\npm.environment.set(\"emailCriado\", pm.environment.get(\"email\"));\r\n\r\nconsole.log(\"ID do usuário:\", responseData._id);\r\nconsole.log(\"Email usado no cadastro:\", pm.environment.get(\"email\"));\r\nconsole.log(\"Email salvo para o PUT:\", pm.environment.get(\"emailCriado\"));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const timestamp = Date.now();\r\nconst email = `user_${timestamp}@qa.com`;\r\nconst password = \"123456\";\r\n\r\npm.environment.set(\"email\", email);\r\npm.environment.set(\"password\", password);\r\n\r\nconsole.log(email);"
