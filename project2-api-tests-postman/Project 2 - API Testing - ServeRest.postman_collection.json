        {
          "name": "Get User By ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "\r\npm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"User has a name and email\", function () {\r\n    const jsonData = pm.response.json();\r\n\r\n    pm.expect(jsonData.nome).to.be.a(\"string\").and.not.empty;\r\n    pm.expect(jsonData.email).to.be.a(\"string\").and.not.empty;\r\n});\r\n\r\npm.test(\"Returned userId matches requested userId\", function () {\r\n    const jsonData = pm.response.json();\r\n\r\n    pm.expect(jsonData._id).to.eql(\r\n        pm.environment.get(\"userId\")\r\n    );\r\n});\r\n\r\n"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
