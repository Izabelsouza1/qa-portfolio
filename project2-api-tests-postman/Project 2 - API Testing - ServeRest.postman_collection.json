    {
      "name": "03 - Products",
      "item": [
        {
          "name": "Create Product (with token)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "//gerar nome de produto automatico, salva em environment\r\nconst timestamp = Date.now();\r\nconst nomeProduto = `Produto QA ${timestamp}`;\r\n\r\npm.environment.set(\"nomeProduto\", nomeProduto);\r\n\r\nconsole.log(\"Produto a ser criado:\", nomeProduto);\r\n"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"nome\": \"{{nomeProduto}}\",\r\n    \"preco\": 100,\r\n    \"descricao\": \"Produto de teste automatizado\",\r\n    \"quantidade\": 10\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "https://serverest.dev/produtos",
              "protocol": "https",
              "host": [
                "serverest",
                "dev"
              ],
              "path": [
                "produtos"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create Product (without token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "\r\npm.test(\"Status code is 401\", function () {\r\n    pm.response.to.have.status(401);\r\n});\r\n\r\npm.test(\"API rejects product creation without token\", function () {\r\n    const jsonData = pm.response.json();\r\n\r\n    pm.expect(jsonData.message).to.eql(\r\n        \"Token de acesso ausente, inválido, expirado ou usuário do token não existe mais\"\r\n    );\r\n});\r\n"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
